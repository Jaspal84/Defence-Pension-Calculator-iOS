{
  "name": "defence-pension-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --env local",
    "deploy:check": "npm run build && wrangler deploy --env=\"\" --dry-run --outdir .worker-build",
    "db:local": "wrangler d1 migrations apply pension-payments --local --env local",
    "deploy": "npm run build && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.45.0",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@types/node": "^24.0.0",
    "pdf-lib": "^1.17.1"
  }
}
